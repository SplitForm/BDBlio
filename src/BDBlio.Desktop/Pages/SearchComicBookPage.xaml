<Page x:Class="BDBlio.Desktop.SearchComicBookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:BDBlio.Desktop"
      mc:Ignorable="d"
      Title="Rechercher une BD"
      Background="#1E1E1E"
      Foreground="#FFFFFF">
    <ScrollViewer>
        <StackPanel Padding="30" Spacing="20">
            <TextBlock Text="Rechercher dans votre bibliothèque" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="#6B5AED"/>

            <!-- Section Scan Code-barres -->
            <Border Background="#2D2D2D" 
                    BorderBrush="#6B5AED" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="📱 Scan Code-barres" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="#00D9FF"/>
                    <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" 
                             Background="#3D3D3D" 
                             Foreground="#FFFFFF" 
                             BorderBrush="#6B5AED" 
                             BorderThickness="1" 
                             Padding="10" 
                             CornerRadius="4" 
                             FontSize="14"
                             Height="40"/>
                    <Button Content="🔍 Rechercher" 
                            Style="{StaticResource ModernButtonStyle}" 
                            Command="{Binding SearchByBarcodeCommand}"
                            Height="40"/>
                </StackPanel>
            </Border>

            <!-- Section Recherche Texte -->
            <Border Background="#2D2D2D" 
                    BorderBrush="#6B5AED" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="🔎 Recherche par texte" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="#00D9FF"/>
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             Background="#3D3D3D" 
                             Foreground="#FFFFFF" 
                             BorderBrush="#6B5AED" 
                             BorderThickness="1" 
                             Padding="10" 
                             CornerRadius="4" 
                             FontSize="14"
                             Height="40"/>
                    <Button Content="🔍 Rechercher" 
                            Style="{StaticResource ModernButtonStyle}" 
                            Command="{Binding SearchByQueryCommand}"
                            Height="40"/>
                </StackPanel>
            </Border>

            <!-- Statut -->
            <TextBlock Text="{Binding StatusMessage}" 
                       FontSize="14" 
                       FontWeight="Bold"
                       Foreground="#00D9FF"
                       TextWrapping="Wrap"/>

            <!-- Résultats -->
            <Border Background="#2D2D2D" 
                    BorderBrush="#6B5AED" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="20"
                    Visibility="{Binding SearchResults.Count, Converter={StaticResource CountToVisibilityConverter}}">
                <StackPanel Spacing="10">
                    <TextBlock Text="📚 Résultats" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="#00D9FF"/>
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#3D3D3D" 
                                        BorderBrush="#B833F0" 
                                        BorderThickness="1" 
                                        CornerRadius="4" 
                                        Padding="15" 
                                        Margin="0,0,0,10">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{Binding Title}" 
                                                   FontSize="14" 
                                                   FontWeight="Bold" 
                                                   Foreground="#FFFFFF"/>
                                        <TextBlock Text="{Binding Author, StringFormat='Auteur: {0}'}" 
                                                   Foreground="#B0B0B0"/>
                                        <TextBlock Text="{Binding Collection, StringFormat='Collection: {0}'}" 
                                                   Foreground="#B0B0B0"/>
                                        <TextBlock Text="{Binding Volume, StringFormat='Tome: {0}'}" 
                                                   Foreground="#B0B0B0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
