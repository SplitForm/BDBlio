<Page x:Class="BDBlio.Desktop.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:BDBlio.Desktop"
      mc:Ignorable="d"
      Title="Ma Bibliothèque"
      Background="#1E1E1E"
      Foreground="#FFFFFF"
      Loaded="Page_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête avec statistiques et tris -->
        <Border Grid.Row="0" 
                Background="#2D2D2D" 
                BorderBrush="#6B5AED" 
                BorderThickness="0,0,0,1" 
                Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="📚 Ma Bibliothèque" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="#6B5AED"/>
                    <TextBlock Text="{Binding TotalBooks, StringFormat='Total: {0} BD'}" 
                               FontSize="12" 
                               Foreground="#B0B0B0"/>
                </StackPanel>

                <!-- Boutons de tri -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Content="Sort: Titre" 
                            Style="{StaticResource ModernButtonStyle}" 
                            Command="{Binding SortByTitleCommand}"
                            Width="120"/>
                    <Button Content="Sort: Auteur" 
                            Style="{StaticResource ModernButtonStyle}" 
                            Command="{Binding SortByAuthorCommand}"
                            Width="120"/>
                    <Button Content="Sort: Collection" 
                            Style="{StaticResource ModernButtonStyle}" 
                            Command="{Binding SortByCollectionCommand}"
                            Width="120"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Liste des BD -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding ComicBooks}" Padding="20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2D2D2D" 
                                BorderBrush="#6B5AED" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="15" 
                                Margin="10" 
                                Width="300"
                                Height="Auto">
                            <StackPanel Spacing="10">
                                <!-- Image de couverture (placeholder) -->
                                <Border Background="#3D3D3D" 
                                        CornerRadius="4" 
                                        Height="200">
                                    <Image Source="{Binding CoverImageUrl}" 
                                           Stretch="UniformToFill"/>
                                </Border>

                                <!-- Informations -->
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding Title}" 
                                               FontSize="14" 
                                               FontWeight="Bold" 
                                               Foreground="#00D9FF"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Author}" 
                                               FontSize="12" 
                                               Foreground="#B0B0B0"/>
                                    <TextBlock Text="{Binding Publisher}" 
                                               FontSize="11" 
                                               Foreground="#909090"/>
                                    <TextBlock Text="{Binding Collection, StringFormat='Collection: {0}'}" 
                                               FontSize="11" 
                                               Foreground="#909090"/>
                                    <TextBlock Text="{Binding Volume, StringFormat='Tome: {0}'}" 
                                               FontSize="11" 
                                               Foreground="#909090"/>
                                </StackPanel>

                                <!-- Bouton supprimer -->
                                <Button Content="🗑️ Supprimer" 
                                        Style="{StaticResource ModernButtonStyle}" 
                                        Background="#FF6B6B"
                                        Command="{Binding DataContext.DeleteBookCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Height="32"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
